DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=app_password
DB_NAME=app_db
 
# Lorsque vous exécutez l'API dans le même docker-compose que MySQL, remplacez par:
# DB_HOST=mysql

# Synchroniser automatiquement le schéma (dev uniquement)
DB_SYNC=false

# Secret pour signer les tokens JWT (CHANGEZ EN PRODUCTION!)
JWT_SECRET=your-super-secret-jwt-key-change-in-production